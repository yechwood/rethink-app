<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/background"
    tools:context=".ui.activity.AppLockActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="36dp"
            android:paddingBottom="36dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/brave_logo"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:src="@drawable/ic_launcher"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:layout_marginBottom="24dp" />

            <LinearLayout
                android:id="@+id/password_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_app_lock_card"
                android:elevation="8dp"
                android:padding="24dp">

                <TextView
                    android:id="@+id/password_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Rethink is locked"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/password_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Enter your password to continue."
                    android:textSize="15sp"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.72"
                    android:gravity="center" />

                <EditText
                    android:id="@+id/password_field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:minHeight="52dp"
                    android:hint="Password"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:importantForAutofill="noExcludeDescendants" />

                <EditText
                    android:id="@+id/password_confirm_field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="52dp"
                    android:hint="Confirm password"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:visibility="gone"
                    android:importantForAutofill="noExcludeDescendants" />

                <TextView
                    android:id="@+id/password_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="13sp"
                    android:textColor="?attr/colorError"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/password_primary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:text="Unlock"
                    android:textAllCaps="false"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/password_secondary"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:text="Change / Remove password"
                    android:textAllCaps="false"
                    android:visibility="gone"
                    style="?android:attr/borderlessButtonStyle" />

                <Button
                    android:id="@+id/password_exit"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="2dp"
                    android:text="Exit"
                    android:textAllCaps="false"
                    style="?android:attr/borderlessButtonStyle" />

            </LinearLayout>

            <TextView
                android:id="@+id/password_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Your password stays on this device."
                android:textSize="12sp"
                android:alpha="0.55"
                android:gravity="center" />

        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
